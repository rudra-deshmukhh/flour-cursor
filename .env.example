# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=your_app_id

# Backend Configuration
NODE_ENV=development
PORT=3000
JWT_SECRET=your_jwt_secret_key
CORS_ORIGIN=http://localhost:4200

# Database Configuration
FIRESTORE_COLLECTION_PREFIX=flour_delivery

# SMS/OTP Configuration (Twilio or similar)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Payment Configuration
PAYMENT_GATEWAY_KEY=your_payment_gateway_key

# Admin Configuration
ADMIN_EMAIL=admin@flourdelivery.com
ADMIN_PASSWORD=admin_password_123

# Flour Mill Configuration
FLOUR_MILL_EMAIL=mill@flourdelivery.com
FLOUR_MILL_PASSWORD=mill_password_123